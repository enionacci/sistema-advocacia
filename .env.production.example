# Exemplo de arquivo .env para VPS (Produção)
# IMPORTANTE: Nunca commite este arquivo com valores reais!

# Django Settings
SECRET_KEY=sua-secret-key-super-segura-aqui-minimo-50-caracteres
DEBUG=False
ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br,easypanel.nacciadvocacia.com.br

# Database (PostgreSQL na VPS)
DB_NAME=sistema_advocacia
DB_USER=postgres
DB_PASSWORD=sua_senha_super_segura_aqui
DB_HOST=localhost
DB_PORT=5432

# Encryption
FERNET_KEY=sua-fernet-key-aqui

# API Keys (Opcional)
OPENAI_API_KEY=sua-openai-key-se-usar

# Frontend
REACT_APP_API_URL=https://api.seu-dominio.com.br
