# ============================================
# CONFIGURAÇÃO DE PRODUÇÃO - VPS
# ============================================
# Arquivo: .env.vps
# Uso: docker-compose -f docker-compose.prod.yml --env-file .env.vps up -d

# ============================================
# DJANGO / BACKEND
# ============================================

# SEGURANÇA - GERE UMA NOVA SECRET KEY!
# Gerar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=SUBSTITUA_POR_UMA_SECRET_KEY_SEGURA_GERADA

# Modo de produção
DEBUG=False

# Hosts permitidos (separe com vírgula)
# Exemplo: meusite.com,www.meusite.com,api.meusite.com
ALLOWED_HOSTS=easypanel.nacciadvocacia.com.br,nacciadvocacia.com.br,www.nacciadvocacia.com.br

# ============================================
# BANCO DE DADOS - POSTGRESQL
# ============================================
DB_NAME=sistema_advocacia
DB_USER=postgres
DB_PASSWORD=@Gui020305
DB_HOST=easypanel.nacciadvocacia.com.br
DB_PORT=5432

# ============================================
# CRIPTOGRAFIA FERNET
# ============================================
# Gerar nova chave: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=7RR3-W6pkGEKUwH3u5chq4wS-811puFPoI2jEmNH97M=

# ============================================
# FRONTEND - REACT
# ============================================
# URL da API backend
REACT_APP_API_URL=https://easypanel.nacciadvocacia.com.br/api
